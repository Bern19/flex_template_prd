{
    "name": "plugin-flex-ts-template-v2",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "test:watch": "jest --watch",
        "test:mychanges": "jest --onlyChanged",
        "test": "jest",
        "test:ci": "jest --silent --ci --coverage --coverageReporters=cobertura --reporters=default --reporters=jest-junit --testResultsProcessor=jest-junit",
        "test:coverage": "jest --silent --coverage && http-server -c-1 ./coverage -o /lcov-report",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "lint:report": "npm run lint -- --output-file eslint_report.json --format json",
        "build": "twilio flex:plugins:build",
        "deploy": "twilio flex:plugins:deploy --bypass-validation",
        "install-flex-plugin": "twilio plugins:install @twilio-labs/plugin-flex@7.1.0",
        "release": "twilio flex:plugins:release --plugin ${npm_package_name}@${npm_package_version}",
        "start": "twilio flex:plugins:start",
        "twilio": "twilio"
    },
    "dependencies": {
        "@emoji-mart/react": "^1.1.1",
        "@twilio-paste/core": "^17.7.0",
        "@twilio-paste/icons": "^9.4.3",
        "@twilio/flex-plugin": "7.1.0",
        "array-move": "^4.0.0",
        "emoji-mart": "5.5.2",
        "filepond": "^4.32.12",
        "filepond-plugin-file-encode": "^2.1.14",
        "filepond-plugin-file-validate-type": "^1.2.9",
        "lodash": "^4.18.1",
        "luxon": "^3.7.2",
        "plugin-flex-ts-template-v2": "file:",
        "prop-types": "^15.8.1",
        "react": "17.0.2",
        "react-beautiful-dnd": "^13.1.1",
        "react-dom": "17.0.2",
        "react-filepond": "^7.1.3",
        "react-minimal-pie-chart": "^8.4.1",
        "react-sortable-hoc": "^2.0.0",
        "rrule": "^2.8.1",
        "semver": "^7.8.5",
        "simple-audio-recorder": "^1.3.0"
    },
    "devDependencies": {
        "@babel/preset-typescript": "^7.29.7",
        "@testing-library/react": "^12.1.5",
        "@twilio/flex-plugin-scripts": "7.1.0",
        "@twilio/flex-ui": "^2.18.0",
        "@types/jest": "^27.5.2",
        "@types/luxon": "^3.7.5",
        "@types/react-beautiful-dnd": "^13.1.8",
        "@types/react-redux": "^7.1.34",
        "@types/semver": "^7.8.0",
        "@types/uuid": "^9.0.8",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.1",
        "eslint-config-twilio": "^2.0.0",
        "import-glob": "^1.5.0",
        "jest": "^27.5.1",
        "jest-fetch-mock": "^3.2.0",
        "jest-junit": "^16.0.0",
        "react-test-renderer": "17.0.2",
        "typescript": "^5.9.3"
    },
    "jest-junit": {
        "outputDirectory": "./test-results"
    }
}
